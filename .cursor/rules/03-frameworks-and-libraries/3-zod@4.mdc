description: APPLY rule WHEN using Zod v4 library for schema validation, type inference, and data transformation in TypeScript projects
globs: src/**/*.{ts,tsx}, **/*.schema.{ts,tsx}, **/schemas/**/*.{ts,tsx}
alwaysApply: false
