## 🔑 Query Key Conventions

```ts
const userKeys = {
  all: ["users"] as const,
  list: (filters: { page: number }) => ["users", "list", filters] as const,
  detail: (id: string) => ["users", "detail", id] as const,
  search: (query: string) => ["users", "search", query] as const,
};
```

- Always define keys as `as const` tuples
- Use descriptive key names for better debugging
- Include dynamic parameters in key arrays
- Avoid string concatenation like `'users_detail_1'`

## 🎯 Query Options Helper

```ts
import { queryOptions } from "@tanstack/react-query";

export const userOptions = {
  list: (filters: { page: number }) =>
    queryOptions({
      queryKey: userKeys.list(filters),
      queryFn: () => fetchUsers(filters),
      staleTime: 1000 * 60 * 5,
      gcTime: 1000 * 60 * 60,
    }),

  detail: (id: string) =>
    queryOptions({
      queryKey: userKeys.detail(id),
      queryFn: () => fetchUser(id),
      enabled: !!id,
    }),
};
```

