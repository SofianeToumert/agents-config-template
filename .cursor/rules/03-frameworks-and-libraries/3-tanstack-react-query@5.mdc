## 🏗️ Shared Layer (`lib/tanstack`)

### `client.ts`

```ts
// src/lib/tanstack/client.ts
import { QueryClient } from '@tanstack/react-query'

export function createQueryClient() {
  return new QueryClient({
    defaultOptions: {
      queries: {
        refetchOnWindowFocus: false,
        retry: 1,
        staleTime: 5 * 60 * 1000,
        gcTime: 60 * 60 * 1000,
      },
      mutations: { retry: 1 },
    },
  })
}

export const queryClient = createQueryClient()
```

### `types.ts`

```ts
// src/lib/tanstack/types.ts
import '@tanstack/react-query'

export type AppRoot = 'users' | 'posts' | 'todos'
export type AppKey = readonly [AppRoot, ...(readonly unknown[])]

declare module '@tanstack/react-query' {
  interface Register {
    queryKey: AppKey
    mutationKey: AppKey
    defaultError: { message: string; code?: string }
    queryMeta: { skipAuth?: boolean }
    mutationMeta: { analytics?: { action: string } }
  }
}
```

### `utils/http.ts`

```ts
// src/lib/tanstack/utils/http.ts
export type HttpOptions = {
  signal?: AbortSignal
  headers?: Record<string, string>
}

export async function http<T>(url: string, opts: HttpOptions = {}): Promise<T> {
  const res = await fetch(url, { signal: opts.signal, headers: opts.headers })
  if (!res.ok) {
    const message = await res.text().catch(() => 'Request failed')
    throw { message, code: String(res.status) } as {
      message: string
      code?: string
    }
  }
  return res.json() as Promise<T>
}
```

