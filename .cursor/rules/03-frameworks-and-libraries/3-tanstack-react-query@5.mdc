## 🗝️ Module: `users` (reference implementation)

### `keys.ts`

```ts
// src/modules/onboarding/api/keys.ts (actual implementation example)
const authBase = ['auth'] as const

export const authKeys = {
  all: () => authBase,
  
  // Query keys following hierarchical pattern
  user: () => [...authBase, 'detail', 'user'] as const,

  // Mutation keys (flat pattern for mutations)
  signupOnboard: () => ['auth', 'signupOnboard'] as const,
  signupVerifyEmail: () => ['auth', 'signupVerifyEmail'] as const,
  signupCreatePassword: () => ['auth', 'signupCreatePassword'] as const,
  updatePersonalInfo: () => ['auth', 'updatePersonalInfo'] as const,
  updateProfessionalInfo: () => ['auth', 'updateProfessionalInfo'] as const,
} as const
```

### `schema.ts`

```ts
// src/modules/users/schema.ts
import { z } from 'zod'

export const userSchema = z.object({
  id: z.string(),
  name: z.string(),
  email: z.string().email(),
})
export type User = z.infer<typeof userSchema>

export const usersPageSchema = z.object({
  items: z.array(userSchema),
  page: z.number(),
  pageCount: z.number(),
})
export type UsersPage = z.infer<typeof usersPageSchema>
```

### `api.ts`

```ts
// src/modules/users/api.ts
import { http } from '@/lib/tanstack/utils/http'
import {
  userSchema,
  usersPageSchema,
  type User,
  type UsersPage,
} from './schema'

export async function fetchUser(
  id: string,
  { signal }: { signal?: AbortSignal } = {}
): Promise<User> {
  const json = await http<unknown>(`/api/users/${id}`, { signal })
  return userSchema.parse(json)
}

export async function fetchUsers(
  filters: { page: number },
  { signal }: { signal?: AbortSignal } = {}
): Promise<UsersPage> {
  const qs = new URLSearchParams({ page: String(filters.page) }).toString()
  const json = await http<unknown>(`/api/users?${qs}`, { signal })
  return usersPageSchema.parse(json)
}

export async function createUser(
  input: Pick<User, 'name' | 'email'>
): Promise<User> {
  const res = await fetch('/api/users', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(input),
  })
  if (!res.ok) throw new Error('Failed to create user')
  return userSchema.parse(await res.json())
}

export async function updateUser(
  id: string,
  patch: Partial<User>
): Promise<User> {
  const res = await fetch(`/api/users/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(patch),
  })
  if (!res.ok) throw new Error('Failed to update user')
  return userSchema.parse(await res.json())
}
```

### `options.ts`

```ts
// src/modules/users/options.ts
import {
  keepPreviousData,
  mutationOptions,
  queryOptions,
} from '@tanstack/react-query'
import { userKeys } from './keys'
import { fetchUser, fetchUsers, createUser, updateUser } from './api'

export const userQueryOptions = {
  list: (filters: { page: number }) =>
    queryOptions({
      queryKey: userKeys.list(filters),
      queryFn: ({ signal }) => fetchUsers(filters, { signal }),
      placeholderData: keepPreviousData, // v5 pagination
      staleTime: 5 * 60 * 1000,
      gcTime: 60 * 60 * 1000,
    }),

  detail: (id: string) =>
    queryOptions({
      queryKey: userKeys.detail(id),
      queryFn: ({ signal }) => fetchUser(id, { signal }),
      enabled: Boolean(id && id.trim()),
    }),
}

export const userMutationOptions = {
  create: () =>
    mutationOptions({
      mutationKey: ['users', 'create'],
      mutationFn: createUser,
    }),

  update: (id: string) =>
    mutationOptions({
      mutationKey: ['users', 'update', id],
      mutationFn: (data: Partial<Parameters<typeof updateUser>[1]>) =>
        updateUser(id, data as any),
    }),
}
```

### `queries.ts`

```ts
// src/modules/users/queries.ts
import { useQuery, useSuspenseQuery } from '@tanstack/react-query'
import { userQueryOptions } from './options'

export const useUsersQuery = (filters: { page: number }) =>
  useQuery(userQueryOptions.list(filters))
export const useUserQuery = (id: string) =>
  useQuery(userQueryOptions.detail(id))

// Only inside <Suspense> + <ErrorBoundary>
export const useUserSuspense = (id: string) =>
  useSuspenseQuery(userQueryOptions.detail(id))
```

### `mutations.ts`

```ts
// src/modules/users/mutations.ts
import { useMutation, useQueryClient } from '@tanstack/react-query'
import { userMutationOptions } from './options'
import { userKeys } from './keys'
import type { User, UsersPage } from './schema'

export const useCreateUserMutation = () => {
  const qc = useQueryClient()
  return useMutation({
    ...userMutationOptions.create(),
    onSuccess: (created) => {
      qc.setQueryData(userKeys.detail(created.id), created)
      qc.invalidateQueries({ queryKey: userKeys.lists() })
    },
  })
}

export const useUpdateUserMutation = (id: string) => {
  const qc = useQueryClient()
  return useMutation({
    ...userMutationOptions.update(id),
    onMutate: async (patch: Partial<User>) => {
      await qc.cancelQueries({ queryKey: userKeys.detail(id) })

      const prevDetail = qc.getQueryData<User>(userKeys.detail(id))
      if (prevDetail) {
        qc.setQueryData<User>(userKeys.detail(id), { ...prevDetail, ...patch })
      }

      const listSnapshots = qc.getQueriesData<UsersPage>({
        queryKey: userKeys.lists(),
      })
      listSnapshots.forEach(([key, old]) => {
        if (!old) return
        qc.setQueryData<UsersPage>(key, {
          ...old,
          items: old.items.map((u) => (u.id === id ? { ...u, ...patch } : u)),
        })
      })

      return { prevDetail, listSnapshots }
    },
    onError: (_e, _vars, ctx) => {
      if (!ctx) return
      qc.setQueryData(userKeys.detail(id), ctx.prevDetail)
      ctx.listSnapshots?.forEach(([key, data]) => qc.setQueryData(key, data))
    },
    onSettled: () => {
      qc.invalidateQueries({ queryKey: userKeys.detail(id) })
      qc.invalidateQueries({ queryKey: userKeys.lists() })
    },
  })
}
```

