## 🧪 Testing (module-local)

- Provide a **module-local** `createTestQueryClient()` with `retry: false`.
- Silence logs with `setLogger`.
- Wrap hooks under test with `QueryClientProvider`.

```ts
import { renderHook, waitFor } from '@testing-library/react';
import { QueryClient, QueryClientProvider, setLogger } from '@tanstack/react-query';
import { useUserQuery } from '@/modules/users/queries';

const createTestQueryClient = () => new QueryClient({
  defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
});

beforeAll(() => setLogger({ log: () => {}, warn: () => {}, error: () => {} }));

const wrapper: React.FC<React.PropsWithChildren> = ({ children }) => (
  <QueryClientProvider client={createTestQueryClient()}>{children}</QueryClientProvider>
);

const { result } = renderHook(() => useUserQuery('1'), { wrapper });
await waitFor(() => expect(result.current.isSuccess).toBe(true));
```

