## 👤 Module Example: `users`

### `types.ts`

```ts
// src/modules/users/store/types.ts
export type UserFilters = { page: number; query: string }

export type UsersState = {
  // UI state only
  selectedId: string | null
  filters: UserFilters
  hydrated: boolean
}

export type UsersActions = {
  setSelected: (id: string | null) => void
  setFilters: (p: Partial<UserFilters>) => void
  setHydrated: (v: boolean) => void
  reset: () => void
}

export type UsersStore = UsersState & UsersActions
```

### `store.ts`

```ts
// src/modules/users/store/store.ts
import { create } from 'zustand'
import { immer } from 'zustand/middleware/immer'
import { persist } from 'zustand/middleware'
import { devtools, createJSONStorage } from 'zustand/middleware'
import type { UsersStore } from './types'

const initialState: UsersStore = {
  selectedId: null,
  filters: { page: 1, query: '' },
  hydrated: false,
  setSelected: () => {},
  setFilters: () => {},
  setHydrated: () => {},
  reset: () => {},
}

export const createUsersStore = (preloaded?: Partial<UsersStore>) =>
  create<UsersStore>()(
    devtools(
      persist(
        immer((set, get) => ({
          ...initialState,
          ...preloaded,
          setSelected: (id) => set({ selectedId: id }, false, 'users/select'),
          setFilters: (p) =>
            set(
              (s) => void Object.assign(s.filters, p),
              false,
              'users/setFilters'
            ),
          setHydrated: (v) => set({ hydrated: v }, false, 'users/hydrated'),
          reset: () => set({ ...initialState }, true, 'users/reset'),
        })),
        {
          name: 'users-ui-v1',
          version: 1,
          storage: createJSONStorage(() => localStorage),
          partialize: (s) => ({ selectedId: s.selectedId, filters: s.filters }),
          skipHydration: true,
          onRehydrateStorage: () => (state) => state?.setHydrated(true),
        }
      ),
      { name: 'usersStore' }
    )
  )

// App singleton (most apps)
export const useUsersStore = createUsersStore()

// Helpers
export const resetUsersStore = () =>
  useUsersStore.setState(
    { selectedId: null, filters: { page: 1, query: '' } },
    true
  )
```

### `selectors.ts`

```ts
// src/modules/users/store/selectors.ts
import { shallow } from '@/lib/zustand/selectors'
import { useUsersStore } from './store'

export const selectSelectedId = (
  s: ReturnType<typeof useUsersStore.getState>
) => s.selectedId
export const selectFilters = (s: ReturnType<typeof useUsersStore.getState>) =>
  s.filters
export const useUsersListParams = () =>
  useUsersStore(
    (s) => ({ page: s.filters.page, query: s.filters.query }),
    shallow
  )
```

### `index.ts`

```ts
// src/modules/users/store/index.ts
export * from './types'
export * from './store'
export * from './selectors'
```

