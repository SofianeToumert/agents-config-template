{
  "mcpServers": {
    "figma": {
      "url": "http://127.0.0.1:3845/mcp"
    },
    "browser-tools": {
      "command": "npx",
      "args": ["-y", "@agentdeskai/browser-tools-mcp@1.2.0"],
      "enabled": true
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "vercel": {
      "url": "https://mcp.vercel.com",
      "headers": {}
    },
    "postgres-dev": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://oorvoo:password@localhost:5432/oorvoo_db"
      ]
    }
  }
}
